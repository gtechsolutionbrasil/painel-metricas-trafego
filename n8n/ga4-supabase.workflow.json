        "jsCode": "// 1 item = resposta runReport (pagePath) de UMA property GA4.\nconst rows = [];\nfor (let i = 0; i < items.length; i++) {\n  const resp = items[i].json;\n  const conta = $('Buscar contas GA4').itemMatching(i).json;\n  for (const r of resp.rows ?? []) {\n    const d = (r.dimensionValues ?? []).map((v) => v.value);\n    const m = (r.metricValues ?? []).map((v) => Number(v.value) || 0);\n    rows.push({\n      client_id: conta.client_id,\n      account_external_id: String(conta.external_id),\n      date: `${d[0].slice(0, 4)}-${d[0].slice(4, 6)}-${d[0].slice(6, 8)}`,\n      kind: 'view',\n      page: d[1] || '(not set)',\n      sessions: 0,\n      views: Math.round(m[0]),\n    });\n  }\n}\nif (rows.length === 0) return [];\nreturn [{ json: { rows, total: rows.length } }];"
