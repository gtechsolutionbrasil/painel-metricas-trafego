    {
      "id": "report-events",
      "name": "GA4 Eventos de contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://analyticsdata.googleapis.com/v1beta/properties/{{ $json.external_id }}:runReport",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAnalyticsOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"dateRanges\":[{\"startDate\":\"7daysAgo\",\"endDate\":\"today\"}],\"dimensions\":[{\"name\":\"date\"},{\"name\":\"eventName\"},{\"name\":\"sessionSource\"},{\"name\":\"sessionMedium\"},{\"name\":\"sessionCampaignName\"}],\"metrics\":[{\"name\":\"eventCount\"},{\"name\":\"keyEvents\"},{\"name\":\"totalUsers\"}],\"dimensionFilter\":{\"filter\":{\"fieldName\":\"eventName\",\"inListFilter\":{\"values\":[\"whatsapp_click\",\"generate_lead\",\"phone_click\",\"route_click\"]}}},\"limit\":\"100000\"}",
        "options": {}
      },
      "notes": "Eventos separados por origem e campanha. route_click é intenção local, não contato principal.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleAnalyticsOAuth2": {
          "id": "I8evqpJf7UDmKsGB",
          "name": "Google Analytics account"
        }
      }
    },
    {
      "id": "map-events",
      "name": "Montar web_events e checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expected = ['whatsapp_click', 'generate_lead', 'phone_click', 'route_click'];\nconst output = [];\nfor (let i = 0; i < items.length; i++) {\n  const resp = items[i].json;\n  const conta = $('Buscar contas GA4').itemMatching(i).json;\n  const totals = Object.fromEntries(expected.map((name) => [name, 0]));\n  const rows = [];\n  for (const r of resp.rows ?? []) {\n    const d = (r.dimensionValues ?? []).map((v) => v.value);\n    const m = (r.metricValues ?? []).map((v) => Number(v.value) || 0);\n    const eventName = d[1] || '(not set)';\n    totals[eventName] = (totals[eventName] ?? 0) + m[0];\n    rows.push({\n      client_id: conta.client_id,\n      account_external_id: String(conta.external_id),\n      date: `${d[0].slice(0, 4)}-${d[0].slice(4, 6)}-${d[0].slice(6, 8)}`,\n      event_name: eventName,\n      source: d[2] || '(not set)',\n      medium: d[3] || '(not set)',\n      campaign: d[4] || '(not set)',\n      event_count: Math.round(m[0]),\n      key_events: m[1],\n      users: Math.round(m[2]),\n    });\n  }\n  const checkedAt = new Date().toISOString();\n  const checks = expected.map((eventName) => ({\n    client_id: conta.client_id,\n    provider: 'ga4',\n    check_key: `event:${eventName}`,\n    status: totals[eventName] > 0 ? 'healthy' : 'warning',\n    value: String(totals[eventName] || 0),\n    message: totals[eventName] > 0\n      ? `${totals[eventName]} evento(s) nos últimos 7 dias.`\n      : 'Nenhum evento nos últimos 7 dias; revisar no Tag Assistant se houver tráfego.',\n    metadata: { account_external_id: String(conta.external_id), window: '7daysAgo:today' },\n    checked_at: checkedAt,\n  }));\n  output.push({\n    json: { accountId: conta.id, rows, checks, total: rows.length },\n    pairedItem: { item: i },\n  });\n}\nreturn output;"
      }
    },
