      "id": "up-metrics",
      "name": "Upsert ad_metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        -160
      ],
      "onError": "continueRegularOutput",
      "credentials": {
