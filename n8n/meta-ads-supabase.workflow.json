    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.external_id }}/insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "campaign_id,campaign_name,date_start,date_stop,spend,impressions,clicks,reach,actions,action_values"
            },
            {
              "name": "level",
              "value": "campaign"
            },
            {
              "name": "time_increment",
              "value": "1"
            },
            {
              "name": "time_range",
              "value": "={{ JSON.stringify({ since: $now.minus({ days: 30 }).toFormat('yyyy-MM-dd'), until: $now.toFormat('yyyy-MM-dd') }) }}"
