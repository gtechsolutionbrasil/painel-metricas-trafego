# ---------------------------------------------------------------------------
# Supabase — copie para .env.local e preencha com as chaves do seu projeto.
# Sem estas variáveis, o painel roda em "modo demonstração" (dados de exemplo).
# ---------------------------------------------------------------------------

# Painel (cliente + servidor) — seguras de expor no browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ingestão (n8n) — NUNCA expor no front. Use só no n8n / scripts de servidor.
# Ignora RLS para gravar métricas. Não commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Webhooks n8n para o botão "Atualizar" (dispara a coleta sob demanda).
N8N_REFRESH_META_URL=
N8N_REFRESH_GOOGLE_URL=
N8N_REFRESH_GA4_URL=
# Header secreto dos webhooks de refresh (X-Refresh-Key validado no n8n).
N8N_REFRESH_SECRET=
